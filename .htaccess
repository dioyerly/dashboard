# Centro de Operaciones - Production Deployment on Hostinger
# Redirects public requests to /public/ and protects internal directories

# Enable rewriting
RewriteEngine On

# Block direct access to sensitive directories
RewriteRule ^(app|config|database|tools|storage|preparation|reference)(/|$) - [F,L]

# Block hidden files (.env, .git, etc.) and backup files
RewriteRule "^\.|\.json$|\.sql$|\.bak$|\.lock$" - [F,L]

# Block direct access to private.php
RewriteRule "^config/private\.php$" - [F,L]

# Disable directory listing
Options -Indexes

# Protect specific files
<FilesMatch "\.env$|\.git|private\.php|\.sql$|\.bak$|\.lock$">
    Require all denied
</FilesMatch>

# MAIN ROUTING: Redirect requests to /public/

# Never reprocess /public/ requests (prevent infinite rewrite loop)
RewriteCond %{REQUEST_URI} ^/public/
RewriteRule ^ - [L]

# Special case: Root request (/) → /public/index.php
RewriteRule ^$ public/index.php [QSA,L]

# For all other requests: check if they exist in /public/, otherwise skip rewrite
# If it's NOT a real file and NOT a real directory in root, rewrite to /public/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/$1 [QSA,L]
